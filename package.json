{
  "name": "rankleem",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check public/app.js",
    "package:source": "node scripts/package.mjs"
  }
}
