PORT=4317
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:4317
BASE_DOMAIN=
# For the selected dummy domain: BASE_DOMAIN=ppc.pm
# and PUBLIC_ORIGIN=https://app.ppc.pm, COOKIE_DOMAIN=ppc.pm.
# Production: set PUBLIC_ORIGIN=https://app.sitocal.com, TRUST_PROXY=true,
# COOKIE_DOMAIN=sitocal.com and ALLOWED_HOSTS to your five hostnames.
# Behind an HTTPS reverse proxy only. Never trust forwarded headers publicly.
TRUST_PROXY=false
COOKIE_DOMAIN=
ALLOWED_HOSTS=localhost,127.0.0.1
# BASE_DOMAIN automatically adds the root/www/app/editor/wp/serp hostnames.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4317/api/google/callback
# Persist encryption key via platform secrets in production (64 hex chars).
# Local development generates data/secret.key automatically.
ENCRYPTION_KEY=
ALLOW_SIGNUPS=true
# Set a long secret invite code in Render before allowing private test signups.
REGISTRATION_CODE=
DAILY_PROVIDER_ACTION_LIMIT=50

# Stripe merchant secrets belong only in Render Environment, never in source.
# Enable after test-mode checkout/webhook/portal validation and commercial terms review.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=

# Social login only — separate from Google Search Console/GA4 credentials.
# Register /api/auth/oauth/{provider}/callback under AUTH_ORIGIN with each provider.
AUTH_ORIGIN=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_LINKEDIN_CLIENT_ID=
AUTH_LINKEDIN_CLIENT_SECRET=
